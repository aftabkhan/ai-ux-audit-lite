# Public site URL used for metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Safe local default. Fixture mode returns deterministic sample data and does
# not inspect screenshot pixels.
AUDIT_PROVIDER=fixture

# Real screenshot-aware provider
# AUDIT_PROVIDER=openai
# OPENAI_API_KEY=replace-with-server-side-secret
# OPENAI_AUDIT_MODEL=gpt-5

# Never expose provider secrets through NEXT_PUBLIC_ variables or commit a
# populated .env file.
